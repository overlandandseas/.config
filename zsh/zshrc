alias db-reset="dropdb obie_dev && dropdb obie_test && createdb obie_dev && createdb obie_test"

# heroku pr console
pr-console() {
	heroku run yarn workspace api console --app obie-rm-review-pr-$1
}

## heroku or database (table plus)
+is_number() {
	re='^[0-9]+$'
  if [[ $1 =~ $re ]]; then
    return 0
  else
    return 1
  fi
}


prdb() {
	if [[ -z $1 ]]; then
	  echo "Usage: $0 <pr-number or app name>"
	  exit 1
	fi

	arg=$1
	appname=$arg

	if +is_number "$arg"; then
	  appname="obie-rm-review-pr-$arg"
	else
	  appname=$arg
	fi

	url=$(heroku config:get DATABASE_URL --app $appname)

	if [[ -z $url ]]; then
	  echo "No app found with name $appname"
	  exit 1
	fi

	open $url
}

